# ==============================================================================
# MentorBridge Environment Configuration & API Keys
# ==============================================================================
# Copy this file to `.env` and fill in your actual API keys and secrets.
# DO NOT commit your `.env` file to version control.

# ------------------------------------------------------------------------------
# 1. Google Gemini AI (Required for AI mentor matching & roadmaps)
# ------------------------------------------------------------------------------
# Get your free key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. Database Connection (Optional - Demo mode works without this)
# ------------------------------------------------------------------------------
# Connect your PostgreSQL, Supabase, Neon, or Railway database.
# Example: postgresql://postgres:password@localhost:5432/mentorbridge
DATABASE_URL=

# ------------------------------------------------------------------------------
# 3. Server Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
LOG_LEVEL=info
